{
    "name": "simple-as-fuck/php-api-toolkit",
    "license": "Unlicense",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "simple-as-fuck/php-validator": "^0.7.11",
        "guzzlehttp/guzzle": "^7.4",
        "illuminate/bus": "^8.81|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^8.81|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^8.81|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^8.81|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.81|^9.0|^10.0|^11.0|^12.0|^13.0",
        "kayex/http-codes": "^1.1",
        "guzzlehttp/psr7": "^2.1",
        "psr/log": "^2.0|^3.0",
        "symfony/psr-http-message-bridge": "^2.1|^6.0|^7.0|^8.0",
        "symfony/http-foundation": "^5.4|^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^5.4|^6.0|^7.0|^8.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "phpstan/phpstan": "^2.1.39",
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan-strict-rules": "^2.0.7",
        "phpstan/phpstan-deprecation-rules": "^2.0.3",
        "spaze/phpstan-disallowed-calls": "^4.7"
    },
    "autoload": {
        "psr-4": {"SimpleAsFuck\\ApiToolkit\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleAsFuck\\ApiToolkit\\Provider\\LaravelProvider"
            ]
        }
    }
}
